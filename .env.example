# SMART QUIZ BOT - CONFIGURATION TEMPLATE
# Copy this file to a new file named '.env' and fill in your details.

# Telegram Bot Token from @BotFather
BOT_TOKEN=

# Channel Username that users must join before using the bot (must start with @)
CHANNEL_USERNAME=@your_channel_username

# Developer Mode (True/False). 
# If True: ignores Telegram joining requirements and activates local browser demo user modes.
# Set to False in production.
DEV_MODE=True

# Mini App Public URL (e.g. your ngrok secure HTTPS link)
# Used for the WebApp persistent keyboard button.
# If left blank, defaults to http://localhost:8000
MINI_APP_URL=

# Host and Port settings for local Uvicorn server
HOST=0.0.0.0
PORT=8000

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
# For Python backend Firebase Admin SDK (either path to json file or JSON string itself)
FIREBASE_SERVICE_ACCOUNT_JSON=
